{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcrn.dev/schemas/workspace-v1.schema.json",
  "title": "TCRN file-native Workspace metadata V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storageVersion",
    "minimumStorageVersion",
    "maximumStorageVersion",
    "workspaceId",
    "externalKey",
    "createdAt",
    "segmentEventLimit",
    "roots"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tcrn.workspace.v1"
    },
    "storageVersion": {
      "const": 1
    },
    "minimumStorageVersion": {
      "const": 1
    },
    "maximumStorageVersion": {
      "const": 1
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^workspace:[a-f0-9]{24}$"
    },
    "externalKey": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "segmentEventLimit": {
      "type": "integer",
      "minimum": 2,
      "maximum": 1024
    },
    "roots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/root"
      }
    },
    "relocations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/relocation"
      }
    }
  },
  "$defs": {
    "relocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sequence",
        "relocationId",
        "stage",
        "at",
        "from",
        "to",
        "basis",
        "authority"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tcrn.workspace-relocation.v1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "relocationId": {
          "type": "string",
          "pattern": "^relocation:[a-f0-9]{24}$"
        },
        "stage": {
          "enum": [
            "vacated",
            "adopted",
            "aborted"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "from": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/root"
          }
        },
        "to": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/root"
          }
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controlManifestSha256",
            "headEventHash",
            "version"
          ],
          "properties": {
            "controlManifestSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "headEventHash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "version": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actorId",
            "authorityFileSha256"
          ],
          "properties": {
            "actorId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160
            },
            "authorityFileSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "canonicalPath",
        "portableIdentity"
      ],
      "properties": {
        "kind": {
          "enum": [
            "framework",
            "workspace",
            "transient",
            "evidence-locator",
            "release-trust"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "canonicalPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "portableIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
