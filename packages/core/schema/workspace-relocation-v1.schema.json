{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcrn.dev/schemas/workspace-relocation-v1.schema.json",
  "title": "TCRN workspace relocation authority and receipts V1",
  "oneOf": [
    {
      "$ref": "#/$defs/authority"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/inspection"
    },
    {
      "$ref": "#/$defs/plan"
    }
  ],
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "permits"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tcrn.workspace-relocation-authority.v1"
        },
        "permits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actorId",
              "workspaceIds",
              "destinations",
              "basis",
              "relocationId",
              "stage"
            ],
            "properties": {
              "actorId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              },
              "workspaceIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^workspace:[a-f0-9]{24}$"
                }
              },
              "destinations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "headEventHash",
                  "version"
                ],
                "properties": {
                  "headEventHash": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "relocationId": {
                "type": "string",
                "pattern": "^relocation:[a-f0-9]{24}$"
              },
              "stage": {
                "enum": [
                  "abort",
                  "adopt",
                  "vacate"
                ]
              },
              "vacateCommitmentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "schemaVersion",
        "reasonCode",
        "relocationId",
        "sequence",
        "stage",
        "at",
        "workspaceRootFrom",
        "workspaceRootTo",
        "basis",
        "authority"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tcrn.workspace-relocation-receipt.v1"
        },
        "reasonCode": {
          "type": "string"
        },
        "relocationId": {
          "type": "string",
          "pattern": "^relocation:[a-f0-9]{24}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "stage": {
          "enum": [
            "vacated",
            "adopted",
            "aborted"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "workspaceRootFrom": {
          "type": "string"
        },
        "workspaceRootTo": {
          "type": "string"
        },
        "basis": {
          "type": "object"
        },
        "authority": {
          "type": "object"
        },
        "controlManifest": {
          "type": "string"
        },
        "targetInspectionSupplied": {
          "type": "boolean"
        },
        "targetInspectionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetInspectionObservedAt": {
          "type": "string",
          "format": "date-time"
        },
        "vacateCommitmentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "forkRisk": {
          "type": "string"
        }
      }
    },
    "inspection": {
      "type": "object",
      "required": [
        "schemaVersion",
        "reasonCode",
        "address",
        "workspaceId",
        "state",
        "relocations",
        "observedAt",
        "activeWorkspaceRoot"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tcrn.workspace-relocation-inspection.v1"
        },
        "reasonCode": {
          "const": "WORKSPACE_RELOCATION_INSPECTED"
        },
        "address": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^workspace:[a-f0-9]{24}$"
        },
        "state": {
          "enum": [
            "live",
            "vacated",
            "adoption-required",
            "foreign-address"
          ]
        },
        "relocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "activeWorkspaceRoot": {
          "type": "string"
        },
        "nearMissDestination": {
          "type": "boolean"
        },
        "forkRisk": {
          "type": "string"
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "schemaVersion",
        "reasonCode",
        "workspaceId",
        "relocationId",
        "sequence",
        "workspaceRootFrom",
        "workspaceRootTo",
        "basis",
        "permitStages",
        "ledgerEntriesRemaining",
        "hopsRemaining",
        "controlManifest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tcrn.workspace-relocation-plan.v1"
        },
        "reasonCode": {
          "const": "WORKSPACE_RELOCATION_PLANNED"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^workspace:[a-f0-9]{24}$"
        },
        "relocationId": {
          "type": "string",
          "pattern": "^relocation:[a-f0-9]{24}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "workspaceRootFrom": {
          "type": "string"
        },
        "workspaceRootTo": {
          "type": "string"
        },
        "basis": {
          "type": "object"
        },
        "permitStages": {
          "type": "array",
          "items": {
            "enum": [
              "abort",
              "adopt",
              "vacate"
            ]
          }
        },
        "ledgerEntriesRemaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "hopsRemaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "controlManifest": {
          "type": "string"
        }
      }
    }
  }
}
