    },
    {
      "id": "host-admission",
      "codex": "out-of-band host digest, binding, and validity window",
      "claude": "out-of-band host digest, binding, product, and validity window",
      "parity": "required"
    },
    {
      "id": "inert-bundle",
      "codex": "four canonical project-local inert templates",
      "claude": "four canonical project-local inert templates",
      "parity": "required"
    },
    {
      "id": "bundle-integrity",
      "codex": "canonical bytes, manifest, bundle, and rollback digests",
      "claude": "canonical bytes, manifest, bundle, and rollback digests",
      "parity": "required"
    },
    {
      "id": "installation-receipt",
      "codex": "independent lstat/open/read receipt admission",
      "claude": "independent lstat/open/read receipt admission",
      "parity": "required"
    },
    {
      "id": "rollback-plan",
      "codex": "identity-bound, non-deleting rollback plan",
      "claude": "identity-bound, non-deleting rollback plan",
      "parity": "required"
    },
    {
      "id": "fallback",
      "codex": "authority-empty and governed-routing-required",
      "claude": "authority-empty, governed-routing-required, claude_md_only",
      "parity": "reason-code parity; mode is host-specific"
    },
    {
      "id": "final-hop-lifecycle",
      "codex": "single owner-visible final hop with duplicate and required-stop guards",
      "claude": "single owner-visible final hop with duplicate and required-stop guards",
      "parity": "required"
    }
  ],
  "hostSpecificSurfaces": [
    {
      "id": "codex-template-root",
      "owner": "codex",
      "contract": ".codex/tcrn-workflow/",
      "reason": "Codex project-local inert templates; no Claude settings merge."
    },
    {
      "id": "claude-template-root",
      "owner": "claude",
      "contract": ".claude/tcrn-workflow/",
      "reason": "Claude project-local inert templates."
    },
    {
      "id": "claude-host-product",
      "owner": "claude",
      "contract": "hostProduct=claude-code plus bounded hostVersionReadback",
      "reason": "Claude host identity is an additional admission fact."
    },
    {
      "id": "claude-settings-fragment",
      "owner": "claude",
      "contract": "reversible tcrnWorkflowInert settings fragment",
      "reason": "Claude Code has a settings merge surface; Codex does not."
    },
    {
      "id": "claude-forbidden-paths",
      "owner": "claude",
      "contract": "project-local .claude paths only",
      "reason": "Claude settings paths need an explicit user-level path boundary."
    }
  ],
  "residuals": [
    {
      "id": "live-activation",
      "appliesTo": [
        "codex",
        "claude"
      ],
