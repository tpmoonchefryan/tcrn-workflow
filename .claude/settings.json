{
  "env": {
    "TCRN_SSH_GOVERNED_HOST": "ci-governed-host.invalid",
    "TCRN_SSH_RUNTIME_ROOT": "/opt/ci-governed-runtime",
    "TCRN_SSH_LOOPBACK": "ci-loopback.invalid",
    "TCRN_SSH_FACADE_ENDPOINT": "ci-facade.invalid:65500",
    "TCRN_SSH_TARGET_ROSTER": "fixtures/observer/ci-target-roster.json"
  },
  "permissions": {
    "deny": [
      "Write(**/.tcrn-workflow/**)",
      "Edit(**/.tcrn-workflow/**)",
      "Write(**/.tcrn-workspace/**)",
      "Edit(**/.tcrn-workspace/**)",
      "Write(~/Code/TCRN Platform/.tcrn-workspace/**)",
      "Edit(~/Code/TCRN Platform/.tcrn-workspace/**)",
      "Write(~/Code/TCRN Platform/.tcrn-workspace/.*)",
      "Edit(~/Code/TCRN Platform/.tcrn-workspace/.*)",
      "Write(~/Code/TCRN Platform/.tcrn-workspace/**/.*)",
      "Edit(~/Code/TCRN Platform/.tcrn-workspace/**/.*)",
      "Write(~/Code/TCRN Platform/.tcrn-workspace/.*/**)",
      "Edit(~/Code/TCRN Platform/.tcrn-workspace/.*/**)",
      "Write(~/Code/TCRN Platform/.tcrn-workspace/**/.*/**)",
      "Edit(~/Code/TCRN Platform/.tcrn-workspace/**/.*/**)",
      "Write(~/.tcrn-workflow/**)",
      "Edit(~/.tcrn-workflow/**)",
      "Write(~/.tcrn-workflow/.*)",
      "Edit(~/.tcrn-workflow/.*)",
      "Write(~/.tcrn-workflow/**/.*)",
      "Edit(~/.tcrn-workflow/**/.*)",
      "Write(~/.tcrn-workflow/.*/**)",
      "Edit(~/.tcrn-workflow/.*/**)",
      "Write(~/.tcrn-workflow/**/.*/**)",
      "Edit(~/.tcrn-workflow/**/.*/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/ssh-write-observer.mjs\""
          }
        ]
      }
    ]
  }
}
